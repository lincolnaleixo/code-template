{
  "name": "@matrix/web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --bun vite --port 3000",
    "build": "bun --bun vite build",
    "start": "bun run .output/server/index.mjs",
    "build:native": "bun --bun vite build --mode native",
    "generate:routes": "tsr generate",
    "typecheck": "bun run generate:routes && tsc -p tsconfig.json"
  },
  "dependencies": {
    "@matrix/api-client": "workspace:*",
    "@matrix/auth": "workspace:*",
    "@matrix/env": "workspace:*",
    "@matrix/ui": "workspace:*",
    "@tanstack/react-query": "catalog:",
    "@tanstack/react-router": "catalog:",
    "@tanstack/react-start": "catalog:",
    "@tanstack/react-table": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@tailwindcss/vite": "catalog:",
    "@tanstack/router-cli": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:"
  }
}
