{
  "name": "@matrix/web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --bun vite --port 3000",
    "build": "bun --bun vite build",
    "start": "bun run .output/server/index.mjs",
    "build:native": "bun --bun vite build --mode native",
    "generate:routes": "tsr generate",
    "typecheck": "bun run generate:routes && tsc -p tsconfig.json"
  },
  "dependencies": {
    "@matrix/api-client": "workspace:*",
    "@matrix/ui": "workspace:*",
    "@tanstack/react-query": "latest",
    "@tanstack/react-router": "latest",
    "@tanstack/react-start": "latest",
    "@tanstack/react-table": "latest",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@tailwindcss/vite": "latest",
    "@tanstack/router-cli": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "nitro": "latest",
    "tailwindcss": "latest",
    "typescript": "latest",
    "vite": "latest"
  }
}
