{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Matrix Template",
  "version": "0.1.0",
  "identifier": "com.matrix.template",
  "build": {
    "beforeDevCommand": "bun run --cwd ../web dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "bun run --cwd ../web build:native",
    "frontendDist": "../../web/dist/client"
  },
  "app": {
    "windows": [
      {
        "title": "Matrix Template",
        "width": 1280,
        "height": 800,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
