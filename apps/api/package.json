{
  "name": "@matrix/api",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "bun --hot src/index.ts",
    "build": "bun build src/index.ts --target=bun --outdir=dist",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@elysiajs/cors": "latest",
    "@matrix/auth": "workspace:*",
    "@matrix/db": "workspace:*",
    "elysia": "latest"
  },
  "devDependencies": {
    "bun-types": "latest",
    "typescript": "latest"
  }
}
