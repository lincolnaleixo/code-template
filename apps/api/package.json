{
  "name": "@matrix/api",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/app.ts"
  },
  "scripts": {
    "dev": "bun --hot src/index.ts",
    "start": "bun src/index.ts",
    "build": "bun build src/index.ts --target=bun --outdir=dist --sourcemap=external",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@elysia/openapi": "catalog:",
    "@elysiajs/cors": "catalog:",
    "@matrix/auth": "workspace:*",
    "@matrix/db": "workspace:*",
    "@matrix/domain": "workspace:*",
    "@matrix/env": "workspace:*",
    "@matrix/observability": "workspace:*",
    "drizzle-orm": "catalog:",
    "elysia": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "typescript": "catalog:"
  }
}
