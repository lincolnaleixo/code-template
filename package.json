{
  "name": "@matrix/code-template",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "@aws-sdk/client-s3": "latest",
      "@aws-sdk/s3-request-presigner": "latest",
      "@better-auth/drizzle-adapter": "latest",
      "@biomejs/biome": "latest",
      "@capacitor/android": "latest",
      "@capacitor/cli": "latest",
      "@capacitor/core": "latest",
      "@capacitor/ios": "latest",
      "@elysia/opentelemetry": "latest",
      "@elysia/openapi": "latest",
      "@elysiajs/cors": "latest",
      "@elysiajs/eden": "latest",
      "@opentelemetry/exporter-trace-otlp-http": "latest",
      "@opentelemetry/sdk-trace-node": "latest",
      "@playwright/test": "latest",
      "@radix-ui/react-slot": "latest",
      "@tailwindcss/vite": "latest",
      "@tanstack/react-query": "latest",
      "@tanstack/react-router": "latest",
      "@tanstack/react-start": "latest",
      "@tanstack/react-table": "latest",
      "@tanstack/router-cli": "latest",
      "@tauri-apps/cli": "latest",
      "@types/bun": "latest",
      "@types/react": "latest",
      "@types/react-dom": "latest",
      "@vitejs/plugin-react": "latest",
      "auth": "latest",
      "better-auth": "latest",
      "class-variance-authority": "latest",
      "clsx": "latest",
      "concurrently": "latest",
      "drizzle-kit": "latest",
      "drizzle-orm": "latest",
      "elysia": "latest",
      "nitro": "latest",
      "postgres": "latest",
      "prom-client": "latest",
      "react": "latest",
      "react-dom": "latest",
      "tailwind-merge": "latest",
      "tailwindcss": "latest",
      "typescript": "7.0.2",
      "vite": "latest",
      "zod": "latest"
    }
  },
  "scripts": {
    "dev": "concurrently -n api,web \"bun run dev:api\" \"bun run dev:web\"",
    "dev:web": "bun run --cwd apps/web dev",
    "dev:api": "bun run --cwd apps/api dev",
    "build": "bun run build:api && bun run build:web",
    "build:web": "bun run --cwd apps/web build",
    "build:api": "bun run --cwd apps/api build",
    "build:native": "bun run --cwd apps/web build:native",
    "build:mobile": "bun run --cwd apps/mobile build",
    "build:desktop": "bun run --cwd apps/desktop build",
    "check": "bun run template:validate && bun run lint:ci && bun run typecheck && bun run test:unit",
    "lint": "biome check --write .",
    "lint:ci": "biome ci .",
    "format": "biome format --write .",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun run test:unit",
    "test:unit": "bun test apps/api/test/health.test.ts packages/domain/test",
    "test:integration": "bun test apps/api/test/app.integration.test.ts",
    "test:e2e": "playwright test",
    "test:coverage": "bun test --coverage apps/api/test packages/domain/test",
    "db:generate": "bun run --cwd packages/db generate",
    "db:migrate": "bun run --cwd packages/db migrate",
    "db:check": "bun run db:generate && git diff --exit-code -- packages/db/drizzle",
    "db:studio": "bun run --cwd packages/db studio",
    "auth:generate": "bun run --cwd packages/auth generate",
    "security:audit": "bun audit --audit-level=high",
    "template:validate": "bun run scripts/validate-template.ts",
    "infra:up": "docker compose up -d postgres minio minio-init",
    "infra:full": "docker compose --profile full up --build -d",
    "infra:logs": "docker compose --profile full logs -f",
    "infra:down": "docker compose --profile full down",
    "infra:reset": "docker compose --profile full down -v --remove-orphans"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@playwright/test": "catalog:",
    "@types/bun": "catalog:",
    "concurrently": "catalog:",
    "typescript": "catalog:"
  }
}
