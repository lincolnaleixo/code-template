{
  "name": "@matrix/code-template",
  "version": "0.3.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "overrides": {
    "@opentelemetry/exporter-prometheus": "0.221.0",
    "@opentelemetry/propagator-jaeger": "2.10.0",
    "@opentelemetry/sdk-node": "0.221.0"
  },
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "@aws-sdk/client-s3": "3.1111.0",
      "@aws-sdk/s3-request-presigner": "3.1111.0",
      "@better-auth/drizzle-adapter": "1.7.1",
      "@biomejs/biome": "2.5.9",
      "@capacitor/android": "8.5.0",
      "@capacitor/cli": "8.5.0",
      "@capacitor/core": "8.5.0",
      "@capacitor/ios": "8.5.0",
      "@elysia/openapi": "1.4.15",
      "@elysia/opentelemetry": "1.4.12",
      "@elysiajs/cors": "1.4.2",
      "@elysiajs/eden": "1.4.9",
      "@opentelemetry/exporter-trace-otlp-http": "0.221.0",
      "@opentelemetry/sdk-trace-node": "2.10.0",
      "@playwright/test": "1.62.1",
      "@radix-ui/react-slot": "1.3.3",
      "@secretlint/secretlint-rule-preset-recommend": "13.0.4",
      "@tailwindcss/vite": "4.3.3",
      "@tanstack/react-query": "5.101.4",
      "@tanstack/react-router": "1.170.29",
      "@tanstack/react-start": "1.168.46",
      "@tanstack/react-table": "9.1.2",
      "@tanstack/router-cli": "1.167.30",
      "@tauri-apps/cli": "2.11.4",
      "@types/bun": "1.4.0",
      "@types/react": "19.2.18",
      "@types/react-dom": "19.2.4",
      "@vitejs/plugin-react": "6.0.5",
      "auth": "1.7.1",
      "better-auth": "1.7.1",
      "class-variance-authority": "0.7.1",
      "clsx": "2.1.1",
      "concurrently": "10.0.5",
      "drizzle-kit": "0.31.10",
      "drizzle-orm": "0.45.2",
      "elysia": "1.4.29",
      "husky": "9.1.7",
      "nitro": "3.0.260610-beta",
      "postgres": "3.4.9",
      "prom-client": "15.1.3",
      "react": "19.2.8",
      "react-dom": "19.2.8",
      "secretlint": "13.0.4",
      "tailwind-merge": "3.6.0",
      "tailwindcss": "4.3.3",
      "typescript": "7.0.2",
      "vite": "8.2.1",
      "zod": "4.4.3"
    }
  },
  "scripts": {
    "prepare": "husky",
    "dev": "concurrently -n api,web \"bun run dev:api\" \"bun run dev:web\"",
    "dev:web": "bun run --cwd apps/web dev",
    "dev:api": "bun run --cwd apps/api dev",
    "build": "bun run build:api && bun run build:web",
    "build:web": "bun run --cwd apps/web build",
    "build:api": "bun run --cwd apps/api build",
    "build:native": "bun run --cwd apps/web build:native",
    "build:mobile": "bun run --cwd apps/mobile build",
    "build:desktop": "bun run --cwd apps/desktop build",
    "check": "bun run template:validate && bun run docs:check && bun run lint:ci && bun run generated:check && bun run typecheck && bun run test:unit",
    "lint": "biome check --write .",
    "lint:ci": "biome ci .",
    "format": "biome format --write .",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun run test:unit",
    "test:unit": "bun test apps/api/test/health.test.ts packages/domain/test packages/env/test packages/observability/test",
    "test:integration": "bun test apps/api/test/app.integration.test.ts",
    "test:e2e": "playwright test",
    "test:a11y": "bun run scripts/check-accessibility.ts",
    "test:template-consumer": "bun run scripts/check-template-consumer.ts",
    "test:secret-guards": "bun run scripts/test-secret-guards.ts",
    "test:coverage": "bun test --coverage apps/api/test/health.test.ts packages/domain/test packages/env/test packages/observability/test",
    "docs:check": "bun run scripts/check-doc-links.ts",
    "db:generate": "bun run --cwd packages/db generate",
    "db:migrate": "bun run --cwd packages/db migrate",
    "db:check": "bun run generated:check",
    "db:studio": "bun run --cwd packages/db studio",
    "auth:generate": "bun run --cwd packages/auth generate",
    "generated:check": "bun run scripts/check-generated.ts",
    "security:audit": "bun audit --audit-level=high",
    "security:commit-message": "bun run scripts/check-commit-message-secrets.ts",
    "security:hooks:verify": "bun run scripts/verify-git-hooks.ts",
    "security:policy": "bun run scripts/check-tracked-secret-policy.ts",
    "security:push": "bun run scripts/check-push-secrets.ts",
    "security:secrets": "secretlint \"**/*\"",
    "security:secrets:verify": "bun run scripts/verify-secret-guards.ts",
    "security:staged": "bun run scripts/check-staged-secrets.ts",
    "prepush:check": "bun run check",
    "template:validate": "bun run scripts/validate-template.ts",
    "version:set": "bun run scripts/set-version.ts",
    "repo:metadata": "bun run scripts/apply-repository-metadata.ts",
    "repo:protect": "bun run scripts/apply-branch-protection.ts",
    "ui:add": "bunx shadcn@4.18.0 add -c apps/web",
    "ui:info": "bunx shadcn@4.18.0 info -c apps/web",
    "ui:info:shared": "bunx shadcn@4.18.0 info -c packages/ui",
    "infra:up": "docker compose up -d postgres minio minio-init",
    "infra:full": "docker compose --profile full up --build -d",
    "infra:observability": "OTEL_ENABLED=true docker compose --profile full --profile observability up --build -d",
    "infra:logs": "docker compose --profile full --profile observability logs -f",
    "infra:down": "docker compose --profile full --profile observability down",
    "infra:reset": "docker compose --profile full --profile observability down -v --remove-orphans"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@playwright/test": "catalog:",
    "@secretlint/secretlint-rule-preset-recommend": "catalog:",
    "@types/bun": "catalog:",
    "concurrently": "catalog:",
    "husky": "catalog:",
    "secretlint": "catalog:",
    "typescript": "catalog:"
  }
}
