NODE_ENV=development
HOST=0.0.0.0
PORT=3001

POSTGRES_USER=matrix
POSTGRES_PASSWORD=matrix
POSTGRES_DB=matrix
DATABASE_URL=postgres://matrix:matrix@localhost:5432/matrix

WEB_URL=http://localhost:3000
PUBLIC_WEB_URL=http://localhost:8080
API_URL=http://localhost:3001
VITE_API_URL=
VITE_APP_NAME=Matrix Template
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,capacitor://localhost,tauri://localhost

BETTER_AUTH_SECRET=change-me-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000
AUTH_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:8080,capacitor://localhost,tauri://localhost

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=matrix
S3_ACCESS_KEY=minio
S3_SECRET_KEY=miniosecret

LOG_LEVEL=info
METRICS_TOKEN=
OTEL_ENABLED=false
OTEL_SERVICE_NAME=matrix-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces

