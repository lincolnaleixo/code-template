:80 {
  encode zstd gzip

  header {
    -Server
    X-Content-Type-Options nosniff
    Referrer-Policy no-referrer
    Permissions-Policy "camera=(), microphone=(), geolocation=()"
  }

  @api path /api/* /health /ready /metrics /openapi*
  handle @api {
    reverse_proxy api:3001
  }

  handle {
    reverse_proxy web:3000
  }
}
